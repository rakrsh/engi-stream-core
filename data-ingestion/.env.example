# Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Keys
# ============================================

# NREL API Key - Get from https://developer.nrel.gov/
NREL_API_KEY=

# NASA API Key - Get from https://api.nasa.gov/
# Default: DEMO_KEY (rate limited)
NASA_API_KEY=DEMO_KEY

# ============================================
# Kafka Configuration
# ============================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=telemetry.raw
KAFKA_TOPIC_BATCH=batch.raw
KAFKA_CONSUMER_GROUP=ingestion-service

# ============================================
# Database Configuration
# ============================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_data

# ============================================
# Service Configuration
# ============================================

BATCH_SIZE=1000
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=5

# ============================================
# Great Expectations
# ============================================

GREAT_EXPECTATIONS_CHECKPOINT=energy_data_checkpoint
GX_HOME=/tmp/gx

# ============================================
# Airflow Configuration
# ============================================

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/energy_data
AIRFLOW__CORE__LOAD_EXAMPLES=false

# ============================================
# Spark Configuration
# ============================================

SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ============================================
# Environment
# ============================================

ENV=development
LOG_LEVEL=INFO
